# Copier en .env et remplir. Le .env reel n'est pas versionne.

# Secret partage proxy <-> backends. Generer avec: openssl rand -hex 32
# Le proxy refuse de demarrer sur un bind registry non-loopback tant qu'il
# vaut sa valeur par defaut.
NIMBUS_SHARED_SECRET=change-me-and-keep-secret
# Token bearer pour /status du proxy. Generer avec: openssl rand -hex 24
METRICS_TOKEN=change-me-too

# release = zip publie ci-dessous, local = build presente dans stratum-local/
STRATUM_MODE=release
STRATUM_URL=https://github.com/StratumServer/Stratum/releases/download/v1.22.6-stratum.1-indev.1/stratum-1.22.6-stratum.1-indev.1-linux-x64.zip
NIMBUS_URL=https://github.com/StratumServer/Nimbus/releases/download/v0.3.0/Nimbus-v0.3.0.zip

# Identite systeme des conteneurs, pour que worlds/ ne soit pas en root.
PUID=1000
PGID=1000

# Ports. Seul PROXY_PORT est publie, les backends restent prives.
PROXY_PORT=42420
SURVIVAL_PORT=42421
CREATIVE_PORT=42422
REGISTRY_PORT=8765
METRICS_PORT=42500

MAX_CLIENTS=16

# Whitelist des backends. 0 Default (= active sur un serveur dedie), 1 Off, 2 On.
VS_WHITELIST_MODE=1

# Administrateurs, "uid:pseudo" separes par des espaces. L uid se lit dans
# Playerdata/playerdata.json apres une premiere connexion.
VS_ADMINS=

# Adresse publique tamponnee dans les paquets de redirection, "hote:port".
# Vide = comportement par defaut, suffisant en local.
REDIRECT_ADDRESS=
