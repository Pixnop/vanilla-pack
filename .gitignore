.env
.build/

# Les mondes ne sont pas versionnes, mais les dossiers doivent exister avant le
# premier up : sinon docker cree les points de montage en root et le conteneur,
# qui tourne sous PUID:PGID, ne peut plus y ecrire.
worlds/*
!worlds/survival/
!worlds/creative/
worlds/survival/*
worlds/creative/*
!worlds/survival/.gitkeep
!worlds/creative/.gitkeep

# Les binaires des mods ne sont pas redistribues ici, ils appartiennent a
# leurs auteurs. scripts/fetch-mods.sh les recupere depuis le Mod DB.
mods/*.zip

# stratum-local/ ne sert plus qu a tester une branche non publiee, via
# scripts/build-stratum.sh. Le dossier doit exister meme vide, le Dockerfile le
# COPY quel que soit le mode.
stratum-local/*
!stratum-local/.gitkeep

# Zips produits par build-translation.sh
dist/

# Paquet de mods tiers pour les joueurs, regenerable, pas a versionner.
vanilla-pack-mods-optionnels.zip
